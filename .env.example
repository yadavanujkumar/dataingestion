# HOWL Platform - Environment Configuration

# Database Store (Supabase / PostgreSQL)
# Leave empty or set to sqlite:///howl.db for local file-based store
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Supabase direct connection
SUPABASE_DB_URL=
SUPABASE_KEY=
SUPABASE_URL=

# Windsor.ai REST API Key (Phase 2)
WINDSOR_API_KEY=

# Anthropic Claude API Key (Phase 1)
ANTHROPIC_API_KEY=

# Google Drive / Sheets / Gmail Service Account Path
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json
HOWL_DRIVE_ROOT_FOLDER_ID=

# Slack Webhook / Bot Token (Phase 4)
SLACK_BOT_TOKEN=
SLACK_REVIEWER_CHANNEL_ID=
